---
import CtaPanel from "../components/shared/CtaPanel.astro";
import FeaturedService from "../components/shared/FeaturedService.astro";
import HomeHero from "../components/shared/HomeHero.astro";
import ServicesPreview from "../components/shared/ServicesPreview.astro";
import TestimonialsSection from "../components/shared/TestimonialsSection.astro";
import TrustStrip from "../components/shared/TrustStrip.astro";
import { homePageContent } from "../config/content/home";
import { allServices } from "../config/content/services-index";
import { firm } from "../config/firm";
import { getLawFirmStructuredData } from "../config/structured-data";
import BaseLayout from "../layouts/BaseLayout.astro";

const structuredData = getLawFirmStructuredData();

// Supporting services: wills, family, personal injury (indices 1, 2, 3 from allServices)
const supportingServices = allServices.slice(1, 7);
---

<BaseLayout
	title={`Solicitors in Kilkenny | ${firm.companyName}`}
	description={homePageContent.seo.description}
	canonicalPath={homePageContent.seo.canonicalPath}
	structuredData={structuredData}
>
	<HomeHero />

	<TrustStrip
		title={homePageContent.trustStrip.title}
		paragraphs={homePageContent.trustStrip.paragraphs}
		stats={homePageContent.trustStrip.stats}
	/>

	<FeaturedService
		eyebrow={homePageContent.featuredService.eyebrow}
		card={homePageContent.featuredService.card}
		aside={homePageContent.featuredService.aside}
	/>

	<ServicesPreview
		eyebrow={homePageContent.supportingServices.eyebrow}
		title={homePageContent.supportingServices.title}
		services={supportingServices}
		bgClass=""
	/>

	<TestimonialsSection />

	<CtaPanel variant="subtle" />
</BaseLayout>
