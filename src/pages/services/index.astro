---
import CtaPanel from "../../components/shared/CtaPanel.astro";
import PageHeader from "../../components/shared/PageHeader.astro";
import ServiceCardsGrid from "../../components/shared/ServiceCardsGrid.astro";
import { servicesIndexContent } from "../../config/content/services-index";
import { firm } from "../../config/firm";
import { getLawFirmStructuredData } from "../../config/structured-data";
import BaseLayout from "../../layouts/BaseLayout.astro";

const structuredData = getLawFirmStructuredData();
---

<BaseLayout
	title={`${servicesIndexContent.seo.title} | ${firm.companyName}`}
	description={servicesIndexContent.seo.description}
	canonicalPath={servicesIndexContent.seo.canonicalPath}
	ogType="website"
	structuredData={structuredData}
>
	<PageHeader
		eyebrow={servicesIndexContent.hero.eyebrow}
		title={servicesIndexContent.hero.title}
		subtitle={servicesIndexContent.hero.subtitle}
	/>

	<section class="pb-16 sm:pb-24">
		<div class="container-page">
			<ServiceCardsGrid />
		</div>
	</section>

	<!-- CTA -->
	<CtaPanel title={servicesIndexContent.cta.title} body={servicesIndexContent.cta.body} />
</BaseLayout>
