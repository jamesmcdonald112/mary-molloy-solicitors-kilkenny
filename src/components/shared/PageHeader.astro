---
interface Props {
	eyebrow: string;
	title: string;
	subtitle: string;
}

const { eyebrow, title, subtitle } = Astro.props as Props;
---

<section class="pt-12 sm:pt-16
	pb-12 sm:pb-16">
	<div class="container-page">
		<div class="max-w-2xl">
			<p class="eyebrow text-text-accent">{eyebrow}</p>
			<h1 class="mt-3
				text-4xl sm:text-5xl
				font-semibold tracking-tight text-heading">
				{title}
			</h1>
			<p class="mt-4 text-lg/8 text-text">{subtitle}</p>
		</div>
	</div>
</section>
