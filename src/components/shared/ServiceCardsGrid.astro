---
import { Image } from "astro:assets";
import { allServices } from "../../config/content/services-index";

type Service = (typeof allServices)[number];

interface Props {
	services?: readonly Service[];
}

const { services = allServices } = Astro.props;
---

<ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" role="list">
	{
		services.map((service, i) => (
			<li class="flex">
				<a
					href={service.href}
					class="
						group relative overflow-hidden
						flex flex-col w-full
						p-10
						border-border hover:border-accent border-2 border-t-heading hover:rounded-2xl
						shadow-md hover:shadow-xl
						hover:-translate-y-2
						focus-ring
						transition-all duration-500"
				>
					{/* Single image — whisper at rest, full on hover */}
					<Image
						src={service.image}
						alt=""
						aria-hidden="true"
						class={`
								absolute inset-0 size-full 
								object-cover 
								${"imageClass" in service ? service.imageClass : "object-center"} 
								opacity-20 group-hover:opacity-100 
								group-hover:animate-card-pan 
								transition-opacity duration-500`}
						widths={[400, 640, 800]}
						sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
					/>

					{/* Bloom overlay — white radial mask at rest, fades out on hover */}
					<div
						class="
						absolute inset-0 
						card-bloom 
						opacity-90 group-hover:opacity-0 
						transition-opacity duration-500"
					/>

					{/* Dark overlay — fades in on hover */}
					<div
						class="
						absolute inset-0 
						bg-black/60 
						opacity-0 group-hover:opacity-100 
						transition-opacity duration-500"
					/>

					{/* Card header — number + icon + tag + title */}
					<div class="relative">
						{/* Number fades out, icon slides from right to centre */}
						<div class="relative h-6">
							<span
								class="
								absolute left-0 top-1/2 -translate-y-1/2
								text-sm font-semibold text-text-muted
								opacity-100 group-hover:opacity-0
								transition-opacity duration-500"
							>
								{String(i + 1).padStart(2, "0")}
							</span>

							{/* Icon */}
							<span
								aria-hidden="true"
								class="
									absolute right-0 top-1/2 -translate-y-1/2
									group-hover:right-1/2 group-hover:translate-x-1/2
									text-accent group-hover:text-white
									[&_svg]:size-6
									transition-all duration-500"
								set:html={service.icon}
							/>
						</div>

						{/* Tag */}
						<p
							class="
							mt-4 text-xs
							font-semibold uppercase tracking-widest 
							text-accent group-hover:text-white/60
							transition-colors duration-500"
						>
							{service.tag}
						</p>

						{/* Title */}
						<p
							class="
							mt-1
							text-xl font-semibold text-heading group-hover:text-accent
							transition-colors duration-500"
						>
							{service.title}
						</p>
					</div>

					{/* Card body — description + link */}
					<div class="relative mt-3 flex flex-1 flex-col">
						{/* Description */}
						<p
							class="
							flex-1
							text-sm/6 text-text group-hover:text-white
							transition-colors duration-500"
						>
							{service.description}
						</p>

						{/* Link */}
						<p
							class="
							mt-6
							text-sm font-semibold text-heading group-hover:text-accent
							transition-colors duration-500"
						>
							Learn more{" "}
							<span
								aria-hidden="true"
								class="
									inline-block
									group-hover:translate-x-1
									transition-transform duration-500"
							>
								&rarr;
							</span>
						</p>
					</div>
				</a>
			</li>
		))
	}
</ul>
