---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { globalCtas } from "../../config/ctas";
import ButtonLink from "../ui/ButtonLink.astro";

interface Props {
	title: string;
	subtitle: string;
	image: ImageMetadata;
	eyebrow?: string;
	imageClass?: string;
	overlayClass?: string;
}

const {
	title,
	subtitle,
	image,
	imageClass = "",
	overlayClass = "bg-black/55",
	eyebrow,
} = Astro.props as Props;
---

{/* Full-bleed hero: image fills the container, text sits at the bottom over a dark overlay */}
<div
	class="relative isolate overflow-hidden
		flex flex-col justify-center
		min-h-[480px] lg:min-h-[540px]"
>
	{/* Background image — covers the full hero, focal point controlled by imageClass */}
	<Image
		src={image}
		alt=""
		aria-hidden="true"
		fetchpriority="high"
		widths={[768, 1280, 1920]}
		sizes="100vw"
		class={`absolute inset-0 size-full object-cover ${imageClass}`}
	/>

	{/* Dark overlay to ensure text is legible over the image */}
	<div class={`absolute inset-0 ${overlayClass}`}></div>

	{/* Back arrow — top-left, links back to Services */}
	<a
		href="/services"
		aria-label="Back to Our Services"
		class="group
			absolute
			top-6 lg:top-8
			left-6 lg:left-8
			z-10
			inline-flex items-center justify-center
			size-10 rounded-full
			bg-white/10 hover:bg-white/20
			text-white
			backdrop-blur-sm
			focus-ring
			transition-colors duration-200"
	>
		<span
			aria-hidden="true"
			class="inline-block
				text-lg
				group-hover:-translate-x-0.5
				transition-transform duration-200"
			>&larr;</span
		>
	</a>

	{/* Text content — sits above the overlay */}
	<div class="relative container-page w-full pt-20 pb-16 lg:py-24">
		<div class="max-w-2xl">
			{eyebrow && <p class="eyebrow text-accent">{eyebrow}</p>}

			<h1
				class="mt-4
					text-4xl lg:text-5xl xl:text-6xl
					font-semibold tracking-tight text-pretty text-white"
			>
				{title}
			</h1>

			<p class="mt-6
				text-lg lg:text-xl/8
				font-normal text-pretty text-white">
				{subtitle}
			</p>

			<div class="mt-10
				flex
				flex-col sm:flex-row
				sm:items-center
				gap-4">
				<ButtonLink
					href={globalCtas.call.href}
					size="lg"
					block={true}
					label={globalCtas.call.label}
					icon={globalCtas.call.icon}
				/>
				<ButtonLink
					href={globalCtas.email.href}
					variant="solid-inverse"
					size="lg"
					block={true}
					label={globalCtas.email.label}
					endArrow={true}
					class="text-black hover:text-text-on-accent"
				/>
			</div>
		</div>
	</div>
</div>
