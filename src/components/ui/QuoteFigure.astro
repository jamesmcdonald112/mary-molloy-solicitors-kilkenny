---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import QuoteMark from "./QuoteMark.astro";

interface Props {
	text: string;
	attribution?: string;
	image?: ImageMetadata;
}

const { text, attribution, image } = Astro.props as Props;
---

<figure class="border-l-2 border-accent pl-8">
	<QuoteMark />
	<blockquote class="mt-2 text-xl/8 font-semibold tracking-tight text-text-muted text-pretty italic">
		<p>{text}</p>
	</blockquote>
	{(attribution || image) && (
		<figcaption class="mt-6 flex items-center gap-3">
			{image && (
				<Image
					src={image}
					alt={attribution ?? ""}
					class="size-10 rounded-full object-cover flex-none"
				/>
			)}
			{attribution && (
				<span class="text-sm/6 text-text-muted">{attribution}</span>
			)}
		</figcaption>
	)}
</figure>
