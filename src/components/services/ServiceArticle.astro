---
import type { ImageMetadata } from "astro";
import checkCircleIcon from "../../assets/icons/checkCircleIcon.svg?raw";
import QuoteFigure from "../ui/QuoteFigure.astro";

type Block =
	| { type: "paragraph"; text: string }
	| { type: "heading"; text: string }
	| { type: "list"; items: readonly { label?: string; text: string }[] };

interface Quote {
	text: string;
	attribution?: string;
	image?: ImageMetadata;
}

interface Props {
	eyebrow?: string;
	title: string;
	intro?: string;
	blocks: readonly Block[];
	quote?: Quote;
}

const { eyebrow, title, intro, blocks, quote } = Astro.props as Props;
---

<div class="py-16 sm:py-24">
	<div class="container-page">
		{/* ── Header: eyebrow and title ───────────────────────────── */}
		{eyebrow && <p class="eyebrow text-text-accent">{eyebrow}</p>}
		<h2 class="mt-3 section-heading">{title}</h2>

		{/* ── Body: two-column grid ────────────────────────────────── */}
		{/* Desktop: content left col-7, quote right col-5             */}
		{/* Mobile: intro → quote → blocks                             */}
		<div
			class={`
				mt-10
				grid
				grid-cols-1 ${quote ? "lg:grid-cols-12" : ""}
				gap-x-12 gap-y-10`}
		>
			{/* ── Content column ───────────────────────────────────── */}
			<div
				class={`
					${quote ? "lg:col-span-7" : "max-w-2xl"}
					space-y-8
					text-base/7 text-text`}
			>
				{intro && <p class="text-base/7 text-text">{intro}</p>}

				{/* Quote — mobile only, inline after intro */}
				{
					quote && (
						<aside class="lg:hidden">
							<QuoteFigure text={quote.text} attribution={quote.attribution} image={quote.image} />
						</aside>
					)
				}

				{
					blocks.map((block) => {
						if (block.type === "paragraph") {
							return <p class="text-text">{block.text}</p>;
						}

						if (block.type === "heading") {
							return (
								<h3 class="text-2xl font-semibold tracking-tight text-heading">{block.text}</h3>
							);
						}

						if (block.type === "list") {
							return (
								<ul role="list" class="mt-2 space-y-4">
									{block.items.map((item) => (
										<li class="flex gap-x-3">
											<span
												aria-hidden="true"
												class="mt-1 shrink-0 size-5 [&>svg]:size-5 [&>svg]:fill-current text-success"
												set:html={checkCircleIcon}
											/>
											<span>
												{item.label && (
													<strong class="font-semibold text-text">{item.label}. </strong>
												)}
												{item.text}
											</span>
										</li>
									))}
								</ul>
							);
						}
					})
				}
			</div>

			{/* ── Quote sidebar — desktop only, right column ───────── */}
			{
				quote && (
					<aside class="hidden lg:block lg:col-span-5 lg:self-start lg:sticky lg:top-24">
						<QuoteFigure text={quote.text} attribution={quote.attribution} image={quote.image} />
					</aside>
				)
			}
		</div>
	</div>
</div>
